{
  "manifest_version": 3,
  "name": "QR Wi-Fi RS",
  "version": "0.1.0",
  "description": "Share or connect to Wi-Fi from the browser via the QR Wi-Fi RS native host.",
  "permissions": ["nativeMessaging"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QR Wi-Fi RS"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "qr-wifi-rs@thetomyou.com",
      "strict_min_version": "115.0"
    }
  }
}
